{
  "name": "rating-service",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "migrate": "npx node-pg-migrate up -m db/migrations",
    "migrate:down": "npx node-pg-migrate down -m db/migrations",
    "migrate:create": "npx node-pg-migrate create -m db/migrations",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js",
    "test": "jest"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "http-errors": "~1.6.3",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pool": "^0.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^30.4.2",
    "node-pg-migrate": "^9.0.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2"
  }
}
